@echo off
setlocal
REM Aus 03_webmodul_verschluesseln.bat vom 27.10.2026 abgeleitet; bestehende Encoder-Optionen erhalten.
if not defined IONCUBE_ENCODER_DIR exit /b 2
if not defined IONCUBE_PASSPHRASE exit /b 2
if not defined IONCUBE_OBFUSCATION_KEY exit /b 2
if not defined WEBMODUL_SOURCE exit /b 2
if not defined WEBMODUL_OUTPUT exit /b 2

"%IONCUBE_ENCODER_DIR%/ioncube_encoder74.exe" --exclude "*.*" --encode "*.php" --encode "*.inc" --ignore ".DS_Store/" --ignore "*~" --ignore "~*" --ignore "*.bak" --ignore "*.tmp" --ignore "*.iep" --ignore "*.git" --ignore ".svn/" --ignore ".*/" --ignore "*.swp" --ignore ".DS_Store" --dynamic-key-errors "normal" --no-short-open-tags --no-doc-comments --obfuscation-key "%IONCUBE_OBFUSCATION_KEY%" --obfuscate "linenos" --with-license "fewo.lic" --license-check "auto" --passphrase "%IONCUBE_PASSPHRASE%" --property "Name='Demo'" --property "emptores='0000000'" --property "demo='1'" --property "elogin='0'" --property "angebote='0'" --property "gastlogin='0'" --property "zahlung='0'" --loader-event "corrupt-file=Fehlerhafte Datei" --loader-event "license-corrupt=Fehlerhafte FewoVerwalter Lizenz-Datei" --loader-event "license-header-invalid=Fehlerhafter Lizenz-Header in der FewoVerwalter-Lizenz." --loader-event "license-expired=FewoVerwalter Lizenz abgelaufen." --loader-event "license-property-invalid=Fehlerhafte Lizenz-Einstellungen in der FewoVerwalter Lizenz-Datei." --loader-event "license-not-found=FewoVerwalter Lizenz-Datei wurde nicht gefunden! Bitte wenden Sie sich an den Support." --loader-event "license-server-invalid=Falscher Lizenz-Server" --loader-event "no-permissions=Keine Rechte" --bundle --copy "@/Plugin.php" --copy "@/routes.php" --copy "@/classes/FewoSitemaps.php" --copy "@/classes/RestzahlungsManager.php" --copy "@/classes/SendCron.php" --copy "@/lang/" --copy "@/updates/" "%WEBMODUL_SOURCE%" -o "%WEBMODUL_OUTPUT%"
if errorlevel 1 exit /b %errorlevel%

"%IONCUBE_ENCODER_DIR%/ioncube_encoder81.exe" --exclude "*.*" --encode "*.php" --encode "*.inc" --ignore ".DS_Store/" --ignore "*~" --ignore "~*" --ignore "*.bak" --ignore "*.tmp" --ignore "*.iep" --ignore "*.git" --ignore ".svn/" --ignore ".*/" --ignore "*.swp" --ignore ".DS_Store" --dynamic-key-errors "normal" --no-short-open-tags --no-doc-comments --obfuscation-key "%IONCUBE_OBFUSCATION_KEY%" --obfuscate "linenos" --with-license "fewo.lic" --license-check "auto" --passphrase "%IONCUBE_PASSPHRASE%" --property "Name='Demo'" --property "emptores='0000000'" --property "demo='1'" --property "elogin='0'" --property "angebote='0'" --property "gastlogin='0'" --property "zahlung='0'" --loader-event "corrupt-file=Fehlerhafte Datei" --loader-event "license-corrupt=Fehlerhafte FewoVerwalter Lizenz-Datei" --loader-event "license-header-invalid=Fehlerhafter Lizenz-Header in der FewoVerwalter-Lizenz." --loader-event "license-expired=FewoVerwalter Lizenz abgelaufen." --loader-event "license-property-invalid=Fehlerhafte Lizenz-Einstellungen in der FewoVerwalter Lizenz-Datei." --loader-event "license-not-found=FewoVerwalter Lizenz-Datei wurde nicht gefunden! Bitte wenden Sie sich an den Support." --loader-event "license-server-invalid=Falscher Lizenz-Server" --loader-event "no-permissions=Keine Rechte" --add-to-bundle --only-include-encoded-files --copy "@/Plugin.php" --copy "@/routes.php" --copy "@/classes/FewoSitemaps.php" --copy "@/classes/RestzahlungsManager.php" --copy "@/classes/SendCron.php" --copy "@/lang/" --copy "@/updates/" "%WEBMODUL_SOURCE%" -o "%WEBMODUL_OUTPUT%"
if errorlevel 1 exit /b %errorlevel%

"%IONCUBE_ENCODER_DIR%/ioncube_encoder82.exe" --exclude "*.*" --encode "*.php" --encode "*.inc" --ignore ".DS_Store/" --ignore "*~" --ignore "~*" --ignore "*.bak" --ignore "*.tmp" --ignore "*.iep" --ignore "*.git" --ignore ".svn/" --ignore ".*/" --ignore "*.swp" --ignore ".DS_Store" --dynamic-key-errors "normal" --no-short-open-tags --no-doc-comments --obfuscation-key "%IONCUBE_OBFUSCATION_KEY%" --obfuscate "linenos" --with-license "fewo.lic" --license-check "auto" --passphrase "%IONCUBE_PASSPHRASE%" --property "Name='Demo'" --property "emptores='0000000'" --property "demo='1'" --property "elogin='0'" --property "angebote='0'" --property "gastlogin='0'" --property "zahlung='0'" --loader-event "corrupt-file=Fehlerhafte Datei" --loader-event "license-corrupt=Fehlerhafte FewoVerwalter Lizenz-Datei" --loader-event "license-header-invalid=Fehlerhafter Lizenz-Header in der FewoVerwalter-Lizenz." --loader-event "license-expired=FewoVerwalter Lizenz abgelaufen." --loader-event "license-property-invalid=Fehlerhafte Lizenz-Einstellungen in der FewoVerwalter Lizenz-Datei." --loader-event "license-not-found=FewoVerwalter Lizenz-Datei wurde nicht gefunden! Bitte wenden Sie sich an den Support." --loader-event "license-server-invalid=Falscher Lizenz-Server" --loader-event "no-permissions=Keine Rechte" --add-to-bundle --only-include-encoded-files --copy "@/Plugin.php" --copy "@/routes.php" --copy "@/classes/FewoSitemaps.php" --copy "@/classes/RestzahlungsManager.php" --copy "@/classes/SendCron.php" --copy "@/lang/" --copy "@/updates/" "%WEBMODUL_SOURCE%" -o "%WEBMODUL_OUTPUT%"
if errorlevel 1 exit /b %errorlevel%

exit /b 0
